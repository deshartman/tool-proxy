# Enterprise Knowledge (EK) bundle configuration

EK_PGVECTOR_DSN=postgres://mcp:password@localhost:5432/mcp_connector

# Local file source path jail (colon-separated list of allowed root directories).
# Unset or empty disables local file indexing entirely.
# Example: EK_LOCAL_ROOTS=/var/lib/documents:/opt/data
EK_LOCAL_ROOTS=
