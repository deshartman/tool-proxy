# Template for docker-compose.prod.yml
# Copy to .env and edit before running `docker compose -f docker-compose.prod.yml up -d`.

# ---- Connector image ----
# Pin a version instead of :latest in real deployments.
MCP_VERSION=latest

# ---- Postgres password ----
# NO env var needed. The connector reads the password directly from the
# mounted secret file at /run/secrets/pg_password at container start
# (see docker-compose.prod.yml: POSTGRES_URL_TEMPLATE + POSTGRES_PW_FILE).
# Just make sure ./secrets/pg_password exists on disk (mode 0400) — the
# docker-compose secrets: block mounts it into both containers.
#
# Generate with: openssl rand -hex 24 > ./secrets/pg_password && chmod 400 ./secrets/pg_password

# ---- Optional overrides ----
# LOG_LEVEL=info                # pino level. Debug is chatty.
# INSPECTOR_PORT=9090           # loopback-only; do NOT expose beyond 127.0.0.1
