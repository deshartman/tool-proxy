# Template for docker-compose.prod.yml
# Copy to .env and edit before running `docker compose -f docker-compose.prod.yml up -d`.

# ---- Connector image ----
# Pin a version instead of :latest in real deployments. A restart on a
# floating tag becomes an unplanned upgrade of a process whose whole job is
# holding one long-lived socket.
MCP_VERSION=latest

# ---- Credentials ----
# NOTHING goes here. The connector needs exactly one secret, the 32-byte
# libsodium master key, and it arrives as a read-only file mount at
# /etc/tool-proxy/connector.key (see docker-compose.prod.yml). Mint it with:
#   head -c 32 /dev/urandom > ./secrets/connector.key && chmod 400 ./secrets/connector.key
#
# Controller URL, connector name and auth posture are entered in the
# inspector's Configure Tunnel modal and sealed into the state volume — there
# are no env vars for them.

# ---- Optional overrides ----
# LOG_LEVEL=info                # pino level. Debug is chatty.
# INSPECTOR_PORT=9090           # loopback-only; do NOT expose beyond 127.0.0.1
# HTTPS_PROXY=http://proxy:3128 # honoured on the WSS dial (see CLAUDE.md)
