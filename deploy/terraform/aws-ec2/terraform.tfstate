  "outputs": {
    "check_boot": {
      "value": "ssh -i \u003ckey\u003e -p 2222 ec2-user@127.0.0.1 'sudo tail -30 /var/log/mcp-connector-boot.log'",
      "type": "string"
    },
    "doctor": {
      "value": "ssh -i \u003ckey\u003e -p 2222 ec2-user@127.0.0.1 'sudo sh -c \"cd /opt/mcp-shim/deploy/compose \u0026\u0026 docker compose -f docker-compose.prod.yml exec -T connector node dist/index.js doctor\"'",
      "type": "string"
    },
    "instance_id": {
      "value": "i-0b60147267564f4a2",
      "type": "string"
    },
    "no_inbound_surface": {
      "value": "aws ec2 describe-security-groups --region us-west-2 --group-ids sg-0a31e579aa8835994 --query 'SecurityGroups[0].IpPermissions'",
      "type": "string"
    },
    "open_dashboard_step1": {
      "value": "aws ec2-instance-connect open-tunnel --region us-west-2 --instance-id i-0b60147267564f4a2 --remote-port 22 --local-port 2222",
      "type": "string"
    },
    "open_dashboard_step2": {
      "value": "ssh -i \u003ckey\u003e -p 2222 -N -L 9090:127.0.0.1:9090 ec2-user@127.0.0.1",
      "type": "string"
    },
    "run_command": {
      "value": "ssh -i \u003ckey\u003e -p 2222 ec2-user@127.0.0.1 '\u003ccommand\u003e'",
      "type": "string"
    },
    "send_key": {
      "value": "aws ec2-instance-connect send-ssh-public-key --region us-west-2 --instance-id i-0b60147267564f4a2 --instance-os-user ec2-user --ssh-public-key file:///tmp/eice_key.pub",
      "type": "string"
    },
    "ssh_in": {
      "value": "aws ec2-instance-connect ssh --region us-west-2 --instance-id i-0b60147267564f4a2 --connection-type eice",
      "type": "string"
    }
  },
