# Single connector.yaml for the whole machine. Copy to connector.yaml
# (gitignored), then edit the mcp_servers list to declare which MCPs this
# connector exposes.
#
# Three MCP shapes are supported:
#
#   Type 1 — customer-authored HTTP MCP server.
#     The connector spawns server.ts as a child via tsx and auto-assigns a
#     localhost port. You write the tools, drop them in tools/, and add an
#     entry below with `dir:` set and `endpoint:` omitted.
#
#   Type 2 — connect to an existing MCP server.
#     The connector dials a server you (or someone else) already runs.
#     Either `transport: http` with `endpoint:` set, or `transport: stdio`
#     with `command:` set. No customer-authored code needed.
#
#   Type 3 — bundled, Twilio-authored MCP pre-installed in this image.
#     The connector resolves `bundled: <name>` against the BUNDLED_MCPS
#     registry baked into the image; the customer supplies only a `.env`
#     in the entry's `dir:`. No code, no `pip install`. Bundle source
#     lives in the sibling repo `mcp-shim-bundled/`.
#
# Vars like ${CONTROLLER_URL} are interpolated from .env (in the same
# directory as this yaml — loaded by dotenv/config from CWD at startup).
# The connector identifies itself by `name` on first connect; the controller
# mints a registrationToken in response which the connector persists in
# .connector-state.json (gitignored) for subsequent reconnects.
# Per-MCP secrets (e.g. TWILIO_ACCOUNT_SID) live in the entry's dir/.env
# and are passed only to that child process.

tunnel:
  controller_url: ${CONTROLLER_URL}
  # Customer-chosen connector name; must be unique on the controller. On
  # first connect the controller mints a fresh row keyed to this name.
  # Set CONNECTOR_NAME in .env — no default here, so an unset var fails
  # fast at boot rather than silently binding to a placeholder identity.
  # Also sent on the WS upgrade as `X-Connector-Name` for tunnel-security
  # row lookup.
  name: ${CONNECTOR_NAME}
  # Static bearer for the long-lived `ts_<...>` posture. Leave the default
  # empty (`${...:-}`) when using the OAuth2 posture — the connector picks
  # the path purely from env (OAUTH_CLIENT_ID set → OAuth2). See .env.example
  # for both shapes.
  auth_token: ${TUNNEL_AUTH_TOKEN:-}
  environment: dev

mcp_servers:
  # ── Type 1 (customer-authored) ───────────────────────────────────────
  # Customer-authored locals are NOT listed here. Drop a folder at
  #   ${MCP_DROPIN_DIR}/<name>/tools/*.ts
  # (defaults to mcp/local/<name>/ in dev, /var/lib/mcp-connector/customer-mcps/<name>/
  # in prod) and the connector's drop-in scanner picks it up at boot. The
  # synthesized child runtime in src/sdk/dropin-runner.ts does the wiring.
  # See docs/AUTHOR-LOCAL-MCP.md.
  #
  # If a folder needs the legacy hand-authored shape (its own server.ts),
  # it can still be listed here with `transport: http` + `dir:`. The yaml
  # entry wins over drop-in discovery for the same folder name.

  # Type 2 (3rd-party MCPs) come from the controller UI, not the yaml — see
  # docs/MCP-PROTOCOL.md §"v1.1 — 3rd-party MCP roster (controller-driven)".
  # Operator clicks "New 3rd Party MCP" in the controller; entry is pushed
  # via mcp-config-snapshot / mcp-config-delta and reconciled in connector RAM.

  # ── Type 3 (bundled, pre-installed in the image) ─────────────────────
  # Bundle source lives in the sibling repo `mcp-shim-bundled/`; the image
  # build installs each registered bundle into its own venv. Customer
  # supplies only a `.env` (creds, vector store DSN, embedding config) in
  # the entry's `dir:`. Uncomment once the connector image is built with
  # the bundle pinned (see step 3 of LLAMA-INDEX.md).
  # - name: enterprise_knowledge
  #   bundled: enterprise-knowledge
  #   dir: ./mcp/bundled/enterprise-knowledge
  #   timeout_ms: 600000   # ingest is slow at save time; runtime queries are fast

policy:
  fail_mode: fail_fast
  log_tool_args: redacted
  max_concurrent_calls: 64
  discovery_interval_ms: 30000
  heartbeat_interval_ms: 1500
  tool_timeout_ms: 5000
  # Auto-reconnect on unexpected WS close. Defaults shown; uncomment to
  # override. In a deployed container where the orchestrator is the
  # supervisor (Fargate / Container Apps / GKE with restart policy), set
  # enabled: false so the connector stays in 'closed' on disconnect and
  # the orchestrator's restart loop takes over instead.
  # reconnect:
  #   enabled: true
  #   initial_backoff_ms: 1000
  #   max_backoff_ms: 30000
  #   max_attempts: 0      # 0 = retry forever
