# Build outputs and deps — rebuilt inside the image. Need both root and
# nested patterns: docker's globs don't recurse, so a bare `*.tsbuildinfo`
# would let `connector/tsconfig.tsbuildinfo` slip through and
# cause `tsc --build` inside the container to skip emit (it sees the
# cached buildinfo and thinks the output is already there — but `dist/`
# was correctly excluded, so postbuild then fails on the missing
# dist/index.js).
node_modules
**/node_modules
dist
**/dist
*.tsbuildinfo
**/*.tsbuildinfo

# Secrets and live config — never ship these in an image layer.
.env
**/.env
*.env
**/*.env
!*.env.example
# .env.old is a legacy path that *.env doesn't match (suffix is .old not
# .env) — it existed at repo root at audit time. Explicit patterns for
# every alt-suffix variant a dev might leave behind.
.env.old
**/.env.old
.env.*
**/.env.*
!.env.example
!**/.env.example

# Registration-token state file — writable by the connector at runtime
# (env mode). If a dev builds an image from a directory that has one,
# it should NOT bake in.
.connector-state.json
**/.connector-state.json

# Key material of every shape. `!connector.key.example` keeps a
# placeholder file trackable if deploy/ ever ships one.
*.pem
**/*.pem
*.key
**/*.key
!*.key.example
!**/*.key.example
id_rsa*
**/id_rsa*

# Local Claude Code session state and memory.
.claude
**/.claude

# Live customer-authored config; only the .example variant ships.
connector/config/connector-*.yaml
!connector/config/connector-*.yaml.example

# Repo metadata.
.git
.github
.DS_Store
*.log

# Docs and scripts aren't needed inside the connector image. `mcp/` IS
# shipped — Type 1 entries in connector.yaml reference mcp/local/<name>/
# at runtime and the spawner needs the source tree on disk; Type 2/3
# entries reference mcp/external/<name>/ + mcp/bundled/<name>/ via dir:
# for per-entry .env loading.
docs
README.md
CLAUDE.md
scripts

# Python virtualenvs. `bundles/enterprise-knowledge/.venv/` is ~1 GB of
# dev-installed deps and was silently inflating the Fly build context
# (200+ MB before the .venv content started transferring). Bundle venvs
# are (re)built INSIDE the image by the bundle-build stage, so the
# on-disk copy from dev never needs to ship. Belt-and-braces patterns:
# leading `.venv/` matches at the root, `**/.venv/` for nested.
.venv
**/.venv
.venv/
**/.venv/

# Python bytecode + test caches. `.pytest_cache` shows up wherever pytest
# runs (bundles/enterprise-knowledge/); the others are similar dev
# artifacts that don't belong in the image.
__pycache__
**/__pycache__
*.pyc
*.pyo
.pytest_cache
**/.pytest_cache
.ruff_cache
.mypy_cache
*.egg-info
**/*.egg-info

# Ollama embedding sidecar model cache — hundreds of MB of dev model
# weights. Production deployments run the sidecar as a separate image;
# the cache never ships in the connector image.
.ollama-cache

# graphify output — knowledge graph artifacts for tooling on the dev
# machine. Not shipped.
graphify-out

# Playwright snapshots + logs, dev-only.
.playwright-mcp

# Snapshot tarballs from scripts/snapshot-crm.sh, dev-only.
.local-backups
.local

# Dev-only scaffolding. mock/customers/ is gitignored and is deployed
# as a SEPARATE Fly app (see architectural-plans/CODE-DEPLOY.md §D5),
# not baked into the connector image.
mock

# architectural-plans/ = design docs, not runtime code.
architectural-plans
