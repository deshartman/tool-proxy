# Build outputs and deps — rebuilt inside the image. Need both root and
# nested patterns: docker's globs don't recurse, so a bare `*.tsbuildinfo`
# would let `connector/tsconfig.tsbuildinfo` slip through and
# cause `tsc --build` inside the container to skip emit (it sees the
# cached buildinfo and thinks the output is already there — but `dist/`
# was correctly excluded, so postbuild then fails on the missing
# dist/index.js).
node_modules
**/node_modules
dist
**/dist
*.tsbuildinfo
**/*.tsbuildinfo

# Secrets and live config — never ship these in an image layer.
.env
**/.env
*.env
**/*.env
!*.env.example
# .env.old is a legacy path that *.env doesn't match (suffix is .old not
# .env) — it existed at repo root at audit time. Explicit patterns for
# every alt-suffix variant a dev might leave behind.
.env.old
**/.env.old
.env.*
**/.env.*
!.env.example
!**/.env.example

# Registration-token state file — writable by the connector at runtime
# (env mode). If a dev builds an image from a directory that has one,
# it should NOT bake in.
.connector-state.json
**/.connector-state.json

# Key material of every shape. `!connector.key.example` keeps a
# placeholder file trackable if deploy/ ever ships one.
*.pem
**/*.pem
*.key
**/*.key
!*.key.example
!**/*.key.example
id_rsa*
**/id_rsa*

# Local Claude Code session state and memory.
.claude
**/.claude

# Live customer-authored config; only the .example variant ships.
connector/config/connector-*.yaml
!connector/config/connector-*.yaml.example

# Repo metadata.
.git
.github
.DS_Store
*.log

# Docs and scripts aren't needed inside the connector image.
# `bundled-mcps/` IS shipped — the spawner needs each Type 1 folder's source
# tree on disk at runtime, and dir: entries resolve against it for per-entry
# .env loading.
docs
README.md
CLAUDE.md
scripts

# Python virtualenvs. The connector image ships no Python, but a venv in the
# working tree (a customer MCP that shells out to Python, a local experiment)
# is easily ~1 GB and silently inflates the build context — this cost us 200+
# MB of Fly build transfer once. Kept as cheap insurance. Belt-and-braces
# patterns: leading `.venv/` matches at the root, `**/.venv/` for nested.
.venv
**/.venv
.venv/
**/.venv/

# Python bytecode + test caches. Dev artifacts that don't belong in the
# image, wherever in the tree they appear.
__pycache__
**/__pycache__
*.pyc
*.pyo
.pytest_cache
**/.pytest_cache
.ruff_cache
.mypy_cache
*.egg-info
**/*.egg-info

# Ollama model cache — hundreds of MB of dev model weights. Nothing in this
# repo runs Ollama any more, but a customer developing their own knowledge
# MCP against a local one would produce this; it must never ship.
.ollama-cache

# graphify output — knowledge graph artifacts for tooling on the dev
# machine. Not shipped.
graphify-out

# Playwright snapshots + logs, dev-only.
.playwright-mcp

# Snapshot tarballs from scripts/snapshot-crm.sh, dev-only.
.local-backups
.local

# Dev-only scaffolding. mock/customers/ is gitignored and is deployed
# as a SEPARATE Fly app (see architectural-plans/CODE-DEPLOY.md §D5),
# not baked into the connector image.
mock

# architectural-plans/ = design docs, not runtime code.
architectural-plans

# Local dev symlinks under bundled-mcps/ that mirror content from
# examples/demos/*. The Dockerfile populates bundled-mcps/crm and
# bundled-mcps/sample via explicit COPY lines from examples/demos/,
# so any local copy or symlink here is redundant and — if it's a
# symlink to a host absolute path — breaks the image build (the
# link target doesn't exist inside the container). Only the
# in-tree bundle (agentic-memory) should ship from this
# directory.
bundled-mcps/crm
bundled-mcps/sample
