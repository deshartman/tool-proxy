# Build outputs and deps — rebuilt inside the image. Need both root and
# nested patterns: docker's globs don't recurse, so a bare `*.tsbuildinfo`
# would let `packages/connector/tsconfig.tsbuildinfo` slip through and
# cause `tsc --build` inside the container to skip emit (it sees the
# cached buildinfo and thinks the output is already there — but `dist/`
# was correctly excluded, so postbuild then fails on the missing
# dist/index.js).
node_modules
**/node_modules
dist
**/dist
*.tsbuildinfo
**/*.tsbuildinfo

# Secrets and live config — never ship these in an image layer.
.env
**/.env
*.env
**/*.env
!*.env.example

# Live customer-authored config; only the .example variant ships.
packages/connector/config/connector-*.yaml
!packages/connector/config/connector-*.yaml.example

# Repo metadata.
.git
.github
.DS_Store
*.log

# Docs and scripts aren't needed inside the connector image. `mcp/` IS
# shipped — Type 1 entries in connector.yaml reference mcp/local/<name>/
# at runtime and the spawner needs the source tree on disk; Type 2/3
# entries reference mcp/external/<name>/ + mcp/bundled/<name>/ via dir:
# for per-entry .env loading.
docs
README.md
CLAUDE.md
scripts
