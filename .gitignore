node_modules
dist
*.log
*.tsbuildinfo

# Python artifacts (Type 3 bundle source lives at bundles/<name>/ and uses
# pip + venv during dev; in production the connector image ships only the
# installed venv, not the source tree).
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Env files. Never commit any .env — deployment platforms provide secrets
# via their own mechanism (K8s Secret, Docker Compose secrets, Fly secrets,
# etc.), so there is no customer-authored .env.example at repo root anymore.
# Per-bundle .env.example templates under bundled-mcps/<name>/ or
# customer-mcps/<name>/ stay allowlisted for authors who use dir/.env as
# a dev escape hatch.
.env
*.env.*
!*.env.example

.DS_Store

# Connector live config — legacy dev-only. In production, MCPs come from the
# controller push, bundled-mcps/ auto-discovery, and customer-mcps/ drop-ins.
# The tracked source-of-truth template was retired in the customer-repo
# carve-out; a personal working-tree copy at ./connector.yaml stays gitignored.
**/connector.yaml

# Fly.io generated fly.toml. `mcp-connector deploy init --target fly` writes
# it at the repo root; deploy/fly/fly.toml.example ships as the tracked
# reference.
/fly.toml
!**/fly.toml.example

# EK bundle's declarative source list — legacy customer-authored yaml.
# Retiring in EK-SOURCES-CONSUMER-UI.md (persistence moves to Postgres +
# controller UI). Keep the gitignore rules for now so any local dev copy
# doesn't accidentally land in git; the referenced .example was retired
# in the customer-repo carve-out.
**/sources.yaml
!**/sources.yaml.example

# Per-bundle secrets directory. Holds service-account JSON keys, OAuth
# token caches, etc. — anything credential-shaped that the bundle's
# .env points at. Gitignored unconditionally; secrets never ship in
# the source tree. Customer mounts these from a volume in production.
**/secrets/

# Connector state file — written by the connector on first register (holds
# the registrationToken handed back by the controller). Customer never edits
# directly; clearing it forces a fresh mint on next start.
**/.connector-state.json

# Agentic-memory mock drop-in state file — JSON persistence for the fake
# identity + memory data. Deterministic externalIds mean deleting this
# file rehydrates cleanly on next call; safe to gitignore.
bundled-mcps/agentic-memory/.state.json

# customer-mcps/ is the runtime drop-zone for customer-authored Type 1 MCPs.
# Its README ships (tracked below) so a customer clone shows the shape; every
# actual drop-in stays local — this is a runtime mount point, not a place
# where the customer repo carries other people's code.
customer-mcps/*
!customer-mcps/README.md
graphify-out/*

# Architectural planning docs. Historical plans landed in git through mid-2026;
# going forward, new plans live on-disk only and never ship in the customer
# carve-out repo. Existing tracked plans stay tracked (gitignore only affects
# untracked files) — this rule prevents new plans from entering git.
architectural-plans/

# Snapshot tarballs written by scripts/snapshot-crm.sh.
.local-backups/

# Playwright MCP smoke-test scratch (snapshots + console logs from running
# the inspector through the Playwright browser MCP during verification).
.playwright-mcp/

# Ollama embedding sidecar model cache (dev only). Mount this as a volume
# in docker-compose.dev.yml so the ~274MB model weights survive container
# restarts. Production deployments pre-populate or use baked images.
.ollama-cache/

.local/

# Live-deploy scratch space for REMOVE-NPM commits 4 + 5. Holds
# throwaway Dockerfiles / fly.tomls / sample MCPs used to verify the
# derived-image and volume-mount paths against a real Fly controller.
# Verified commands land in docs/deploy/{DERIVED-IMAGE,VOLUME-MOUNT}.md
# as "Verified example" sections, not as tracked test fixtures.
test/deploy/
