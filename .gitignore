node_modules
dist
*.log
*.tsbuildinfo

# Python artifacts (Type 3 bundle source lives at bundles/<name>/ and uses
# pip + venv during dev; in production the connector image ships only the
# installed venv, not the source tree).
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Env files. Never commit; templates are *.env.example.
.env
*.env
!.env.example
!*.env.example

.DS_Store

# Connector live config — customer-authored copy of connector.yaml.example.
# Lives at packages/connector/connector.yaml. Gitignored; only the *.example
# template ships.
**/connector.yaml
!**/connector.yaml.example

# EK bundle's declarative source list — customer-authored copy of
# sources.yaml.example. Lives at mcp/bundled/enterprise-knowledge/sources.yaml.
# Gitignored; only the *.example template ships.
**/sources.yaml
!**/sources.yaml.example

# Mock CRM seed data — operator-authored copy of data.ts.example with
# real phone numbers in it for live demos. Gitignored to keep PII out of
# the public repo; only the .example template ships.
mock/customers/data.ts
!mock/customers/data.ts.example

# Per-bundle secrets directory. Holds service-account JSON keys, OAuth
# token caches, etc. — anything credential-shaped that the bundle's
# .env points at. Gitignored unconditionally; secrets never ship in
# the source tree. Customer mounts these from a volume in production.
**/secrets/

# Connector state file — written by the connector on first register (holds
# the registrationToken handed back by the controller). Customer never edits
# directly; clearing it forces a fresh mint on next start.
**/.connector-state.json
graphify-out/*

# Playwright MCP smoke-test scratch (snapshots + console logs from running
# the inspector through the Playwright browser MCP during verification).
.playwright-mcp/
