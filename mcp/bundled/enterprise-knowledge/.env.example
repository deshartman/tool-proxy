# Enterprise Knowledge bundle — environment variables.
#
# This file is loaded by the mcp-shim connector when its connector.yaml
# entry for `enterprise_knowledge` carries a `dir:` pointing at this folder
# (or a copy of it under bundle-config/ in the connector repo). The
# connector merges these into the EK MCP child's environment ONLY — they
# do not leak across MCPs and are not visible to the connector core.
#
# Step 2 (the current stub backend) ignores all of these. They become live
# in step 4 when the real LlamaIndex backend lands.

# ── Vector store backend ──────────────────────────────────────────────
# Production default: pgvector (uses customer's Postgres).
# Dev/demo alternative: chroma (file-based, zero external service).
EK_VECTOR_STORE=pgvector

# When EK_VECTOR_STORE=pgvector — required.
# Postgres 14+ with the `pgvector` extension. Bundle creates one table per
# source_id plus an `ek_sources` metadata table.
EK_PGVECTOR_DSN=postgresql://ek:CHANGE_ME@localhost:5432/enterprise_knowledge

# When EK_VECTOR_STORE=chroma — required. Filesystem path to a writable dir.
# EK_CHROMA_PATH=/var/lib/mcp-shim/enterprise-knowledge/chroma

# ── Embedding model ───────────────────────────────────────────────────
# Default: a local HuggingFace model so chunk text never leaves the
# customer environment. Override to use a cloud embedding API if data
# residency is not a concern.
# EK_EMBED_MODEL=BAAI/bge-small-en-v1.5

# ── Source-system credentials (per source kind) ───────────────────────
# Filled in by the customer for each source kind they pin in procedures.
# Kept minimal here; expand as readers land in step 4.

# SharePoint (microsoft graph; service-principal flow recommended)
# EK_SHAREPOINT_TENANT_ID=
# EK_SHAREPOINT_CLIENT_ID=
# EK_SHAREPOINT_CLIENT_SECRET=

# Confluence (cloud or server; PAT recommended)
# EK_CONFLUENCE_BASE_URL=
# EK_CONFLUENCE_TOKEN=
