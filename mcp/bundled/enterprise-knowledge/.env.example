# Enterprise Knowledge bundle — environment variables.
#
# This file is loaded by the mcp-shim connector when its connector.yaml
# entry for `enterprise_knowledge` carries a `dir:` pointing at this folder.
# The connector merges these into the EK MCP child's environment ONLY —
# they do not leak across MCPs and are not visible to the connector core.

# ── Postgres + pgvector (REQUIRED) ────────────────────────────────────
# v1 ships pgvector as the only vector-store backend.
#
# Local dev: bring Postgres up via the repo-root compose file:
#   docker compose -f docker-compose.dev.yml up -d
# Then the DSN below points at it.
#
# Production: point at your own Postgres 14+ with the `pgvector` extension.
# The bundle applies migrations idempotently on startup.
EK_PGVECTOR_DSN=postgresql://ek:ek-dev-password@localhost:5433/enterprise_knowledge

# ── Declarative source list (OPTIONAL) ────────────────────────────────
# Path to sources.yaml — read at every boot, auto-registers each entry
# via the matching <id>_register tool. register_source is idempotent on
# URL, so re-running on every restart is safe.
#
# Per-source failures (Drive folder un-shared, path missing, network
# hiccup) are persisted to ek_sources with status='failed' and surface
# to the Controller via sources_fetch. The bundle still comes up; one
# stale URL doesn't take down the whole bundle.
#
# Leave unset to disable auto-register entirely (admins drive
# <id>_register by hand instead). See sources.yaml.example for format.
# EK_SOURCES_YAML=./sources.yaml

# ── Embedder ──────────────────────────────────────────────────────────
# Pick which embedding provider this bundle uses to convert chunk text
# into vectors. The choice is baked into each indexed source's metadata
# at register time; switching providers later requires re-indexing the
# affected sources (see `sources_refresh` with force=true).
#
# Options:
#   local         — HuggingFace model on this host. Chunk text never
#                   leaves the customer's environment. ~130MB first-run
#                   download into ~/.cache/huggingface/.
#   openai        — OpenAI's embeddings API. Sends chunk text to OpenAI.
#   azure_openai  — Azure-hosted OpenAI deployment. Same data path as
#                   openai, but governed by your Azure tenancy.
EK_EMBEDDER=local

# ── Provider config — uncomment the ONE block matching EK_EMBEDDER ────

# When EK_EMBEDDER=local
# EK_EMBED_MODEL=BAAI/bge-small-en-v1.5

# When EK_EMBEDDER=openai
# OPENAI_API_KEY=sk-...
# EK_EMBED_MODEL=text-embedding-3-small

# When EK_EMBEDDER=azure_openai
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-02-01
# EK_EMBED_MODEL=your-deployment-name

# ── Source-system credentials (parked, not yet wired) ─────────────────
# Confluence reader lands later. These vars are documented here so the
# customer surface doesn't move when the reader ships.
#
# Confluence Cloud (id.atlassian.com mints the API token; works under Okta
# SSO since tokens are account-scoped, not session-scoped):
# EK_CONFLUENCE_BASE_URL=https://your-org.atlassian.net/wiki
# EK_CONFLUENCE_EMAIL=you@your-company.com
# EK_CONFLUENCE_TOKEN=
