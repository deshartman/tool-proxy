# Per-MCP env for the Twilio MCP server. The connector loads this file into
# this child's environment only — it does not leak into other MCPs. Copy
# to .env (gitignored) and fill in.

# Twilio Account SID — always required. Twilio Console > Account Info.
TWILIO_ACCOUNT_SID=

# Auth — pick ONE of the two modes below:
#
# Mode 1 (preferred for production): API Key + Secret. Revocable per-service
# without rotating the master AuthToken. Twilio Console > Account > API keys.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
#
# Mode 2 (dev fallback): AuthToken. Master credential — rotate carefully.
TWILIO_AUTH_TOKEN=

# Phone number used as the From for messages_create (sms channel) and
# calls_create. Must be an E.164 number you own.
TWILIO_FROM_NUMBER=

# WhatsApp sender (E.164). Used by messages_create when channel=whatsapp.
# The MCP prepends `whatsapp:` automatically; provide the bare number here.
# TWILIO_WHATSAPP_FROM=

# RCS agent identifier. Used by messages_create when channel=rcs. The MCP
# prepends `rcs:` automatically; provide the bare agent ID.
# TWILIO_RCS_AGENT=

# Default Verify Service SID (VAxxxx). Used by verify_send / verify_check /
# verify_services_fetch when no explicit serviceSid arg is passed.
# TWILIO_VERIFY_SERVICE_SID=

# Default Messaging Service SID (MGxxxx). Used by messages_create when
# neither `from` nor `messagingServiceSid` is passed, and by
# messaging_services_fetch when no explicit sid arg is passed.
# TWILIO_MESSAGING_SERVICE_SID=
