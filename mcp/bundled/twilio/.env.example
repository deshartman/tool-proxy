# Per-MCP env for the Twilio MCP server. The connector loads this file into
# this child's environment only — it does not leak into other MCPs. Copy
# to .env (gitignored) and fill in.

# Twilio Account SID — always required. Twilio Console > Account Info.
TWILIO_ACCOUNT_SID=

# Twilio Auth Token — required. Master credential, rotate carefully.
# Twilio Console > Account Info. (For revocable per-service credentials,
# mint a scoped subaccount and use its AuthToken.)
TWILIO_AUTH_TOKEN=

# SendGrid API key. Required for email_send / email_fetch / email_search /
# email_templates_fetch. Create at https://app.sendgrid.com/settings/api_keys
# (prefix `SG.`). Use a restricted key with Mail Send + Email Activity scopes
# for production.
SENDGRID_API_KEY=
