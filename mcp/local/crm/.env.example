# Per-MCP env for the crm MCP server. The connector loads this file into
# this child's environment only. Copy to .env (gitignored).
#
# The crm MCP is a thin client over the mock customer service at
# mock/customers/. Override the URL if you run the mock on a different port
# or host. Default: http://localhost:7400
# MOCK_CUSTOMERS_URL=http://localhost:7400
