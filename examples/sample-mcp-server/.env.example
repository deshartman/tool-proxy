# Per-deployment env for the sample MCP server + its connector.
# Copy to .env and fill in. .env is gitignored.

# Pre-provisioned in your controller. Format depends on your controller;
# e.g. conn_xxxxxxxx.
CONNECTOR_ID=conn_REPLACE_ME

# Bearer token for the WS handshake. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
TUNNEL_AUTH_TOKEN=

# Inspector UI port for this connector process.
INSPECTOR_PORT=9090

# Port the sample MCP server listens on.
PORT=7100
