# Per-deployment env for the Twilio MCP server + its connector.
# Copy to .env and fill in. .env is gitignored.

# ── Connector vars ──────────────────────────────────────────────────────
# Pre-provisioned in your controller. Distinct from any other connector
# you run.
CONNECTOR_ID=conn_REPLACE_ME

# Bearer token for the WS handshake. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# (Same value as other deployments today; per-deployment to keep the
# structure ready for distinct tokens later.)
TUNNEL_AUTH_TOKEN=

# Inspector UI port for this connector process.
INSPECTOR_PORT=9091

# Port the Twilio MCP server listens on.
PORT=7200

# ── Twilio API creds (read by the MCP server, not the connector) ────────
# Twilio Console > Account Info has these.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Phone number used as the From for send_sms. Must be a number you own.
TWILIO_FROM=
