# Per-MCP env for the salesforce demo drop-in. Symlinked from bundled-mcps/
# salesforce (non-gated, auto-enabled at connector boot, no approval step) —
# canonical source lives here, under examples/demos/.
#
# Auth: OAuth 2.0 Client Credentials Flow via a Salesforce External Client
# App. See README.md "Salesforce-side setup" for how to create these values.
#
# Copy to `.env` (gitignored). Controller-supplied creds (via creds-response)
# win on conflict — this file is a dev escape hatch, not the production shape.

SF_CLIENT_ID=
SF_CLIENT_SECRET=

# Production org default. Use https://test.salesforce.com for a sandbox, or
# your org's My Domain URL (https://<your-domain>.my.salesforce.com) — most
# orgs require My Domain to be enabled for Client Credentials Flow to work.
SF_LOGIN_URL=https://login.salesforce.com
