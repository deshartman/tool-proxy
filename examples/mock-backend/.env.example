# Mock customer service — Postgres-backed customer store fronting the
# CRM drop-in. Copy to `.env` for local dev; on Fly, set MOCK_POSTGRES_URL
# via `fly secrets set`.

# Required in production. Empty string counts as unset — the server refuses
# to boot without this.
#
# Local dev — leave this blank (or omit the .env file entirely).
# scripts/start-mock-server.sh auto-starts the docker-compose ek-postgres
# container, auto-creates the `crm` database, and defaults MOCK_POSTGRES_URL
# to the container's DSN. The container maps its 5432 to the host's 5433
# (5432 is usually held by another dev-machine Postgres); the auto-provisioned
# DSN is:
#   postgres://ek:ek-dev-password@localhost:5433/crm
# Set MOCK_POSTGRES_URL below only to override (e.g. point at a different
# Postgres). If auth fails, `docker port mcp-shim-ek-postgres`.
#
# Fly production — set via `fly secrets set` on the mock app (never
# committed):
#   MOCK_POSTGRES_URL=postgres://postgres:<pw>@twilio-tool-sdk-db.flycast:5432/crm
MOCK_POSTGRES_URL=

# Optional. Override the port (default 7400). The crm drop-in reaches
# this service via MOCK_CUSTOMERS_URL — set that on the connector app.
# PORT=7400

# Optional. Log level for pino (trace / debug / info / warn / error / fatal).
# Default: info.
# LOG_LEVEL=info
