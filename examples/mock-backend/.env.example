# Mock customer service — Postgres-backed customer store fronting the
# CRM drop-in. Copy to `.env` for local dev; on Fly, set MOCK_POSTGRES_URL
# via `fly secrets set`.

# Required. DSN for the crm database. Empty string counts as unset —
# the server refuses to boot without this.
#
# Local dev — docker-compose ek-postgres container (spun up by
# scripts/start-connector.sh, or explicitly via
# `docker compose -f deploy/compose/docker-compose.dev.yml up -d ek-postgres`).
# The container maps its 5432 to the host's 5433 by default (5432 is
# usually held by another dev-machine Postgres); check `docker port
# mcp-shim-ek-postgres` if this DSN fails auth. The `crm` database must
# be created inside the container first:
#   docker exec mcp-shim-ek-postgres psql -U ek -d postgres -c "CREATE DATABASE crm"
#
#   MOCK_POSTGRES_URL=postgres://ek:ek-dev-password@localhost:5433/crm
#
# Fly production — set via `fly secrets set` on the mock app (never
# committed):
#   MOCK_POSTGRES_URL=postgres://postgres:<pw>@twilio-tool-sdk-db.flycast:5432/crm
MOCK_POSTGRES_URL=

# Optional. Override the port (default 7400). The crm drop-in reaches
# this service via MOCK_CUSTOMERS_URL — set that on the connector app.
# PORT=7400

# Optional. Log level for pino (trace / debug / info / warn / error / fatal).
# Default: info.
# LOG_LEVEL=info
