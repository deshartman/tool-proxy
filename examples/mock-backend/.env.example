# Mock customer service — Postgres-backed customer store fronting the
# CRM drop-in. Copy to `.env` for local dev; on Fly, set MOCK_POSTGRES_URL
# via `fly secrets set`.

# Required. DSN for the crm database. Empty string counts as unset —
# the server refuses to boot without this.
#
# Local dev (Postgres on your laptop or a `fly proxy` tunnel):
#   MOCK_POSTGRES_URL=postgres://postgres:<pw>@localhost:5432/crm
# Fly production (same DSN shape as the connector's POSTGRES_URL):
#   MOCK_POSTGRES_URL=postgres://postgres:<pw>@twilio-tool-sdk-db.flycast:5432/crm
MOCK_POSTGRES_URL=

# Optional. Override the port (default 7400). The crm drop-in reaches
# this service via MOCK_CUSTOMERS_URL — set that on the connector app.
# PORT=7400

# Optional. Log level for pino (trace / debug / info / warn / error / fatal).
# Default: info.
# LOG_LEVEL=info
