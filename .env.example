# Connector-level shared env. Copy to .env (gitignored).
# Per-MCP secrets (Twilio API key, etc.) live in examples/<name>/.env, NOT here.

# ═══════════════════════════════════════════════════════════════════════════
# Tunnel identity + creds live in Postgres, sealed at rest with a 32-byte
# master key. Managed via the inspector UI at http://127.0.0.1:9090/.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Required ──────────────────────────────────────────────────────────────
# Postgres holds the encrypted tunnel row + registration token. The
# `mcp_connector` schema (or whatever POSTGRES_SCHEMA is set to) is created
# idempotently on every boot; safe to point at a database that already hosts
# other schemas (e.g. the enterprise-knowledge bundle's own tables under
# `public`). See docs/deploy for a per-cloud walkthrough.
POSTGRES_URL=postgres://user:pass@host:5432/mcp
# Optional. Default is "mcp_connector". Schema is created on first boot.
# POSTGRES_SCHEMA=mcp_connector

# Master key for sealing tunnel creds at rest. Exactly 32 raw bytes, mode
# 0600. Generate once:
#   mkdir -p /run/secrets/mcp-connector && \
#     head -c 32 /dev/urandom > /run/secrets/mcp-connector/master.key && \
#     chmod 0600 /run/secrets/mcp-connector/master.key
# The SHA-256 fingerprint of this file is recorded in Postgres on first
# boot; changing the key without wiping the schema fails-fast at boot.
CONNECTOR_KEY_FILE=/run/secrets/mcp-connector/master.key

# ─── Optional (global) ─────────────────────────────────────────────────────

# Optional. Inspector UI port (default 9090). Set to 0 to disable.
# INSPECTOR_PORT=9090

# Optional. Base port for Type 1 auto-allocation (default 7100). The spawner
# probes upward from here; you should never need to change this unless 7100+
# is already taken on this host.
# MCP_BASE_PORT=7100
