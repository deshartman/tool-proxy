# Connector-level shared env. Copy to .env (gitignored).
# Per-MCP secrets (Twilio API key, etc.) live in examples/<name>/.env, NOT here.

# ═══════════════════════════════════════════════════════════════════════════
# CONNECTOR_CREDS_SOURCE — pick which mode this connector runs in.
# Default: "db" (unset or empty string → "db")
# Values:
#   "db"   — tunnel identity + creds live in Postgres; managed via the
#            inspector UI at http://127.0.0.1:9090/. Recommended.
#   "env"  — legacy: tunnel identity + creds live in this .env file +
#            connector.yaml + .connector-state.json. Being removed one
#            release after the "db" path is proven; new deployments
#            should NOT choose this.
# ═══════════════════════════════════════════════════════════════════════════
CONNECTOR_CREDS_SOURCE=db

# ─── Vars required when CONNECTOR_CREDS_SOURCE=db (default) ────────────────
# Postgres holds the encrypted tunnel row + registration token. The
# `mcp_connector` schema (or whatever POSTGRES_SCHEMA is set to) is created
# idempotently on every boot; safe to point at a database that already hosts
# other schemas (e.g. the enterprise-knowledge bundle's own tables under
# `public`). See docs/deploy for a per-cloud walkthrough.
POSTGRES_URL=postgres://user:pass@host:5432/mcp
# Optional. Default is "mcp_connector". Schema is created on first boot.
# POSTGRES_SCHEMA=mcp_connector

# Master key for sealing tunnel creds at rest. Exactly 32 raw bytes, mode
# 0600. Generate once:
#   mkdir -p /run/secrets/mcp-connector && \
#     head -c 32 /dev/urandom > /run/secrets/mcp-connector/master.key && \
#     chmod 0600 /run/secrets/mcp-connector/master.key
# The SHA-256 fingerprint of this file is recorded in Postgres on first
# boot; changing the key without wiping the schema fails-fast at boot.
CONNECTOR_KEY_FILE=/run/secrets/mcp-connector/master.key

# ─── Vars required when CONNECTOR_CREDS_SOURCE=env (legacy) ────────────────
# Uncomment the block below AND set CONNECTOR_CREDS_SOURCE=env at the top.
# Under db mode these are ignored (a WARN is logged at boot if any are set).
#
# # Controller HTTPS root. The connector dials this for the register API call
# # and for the WS tunnel — internally it upgrades https:// → wss:// and
# # appends the /mcp-tunnel path. One host, one URL.
# CONTROLLER_URL=https://your-controller.example.com
#
# # Connector identity. Customer-chosen, MUST exactly match the Name field on
# # the controller's Tunnel Security row (case-sensitive — the controller
# # looks up the row by it). Referenced as ${CONNECTOR_NAME} in connector.yaml.
# CONNECTOR_NAME=my-customer
#
# # Auth posture 1 — long-lived bearer (default when OAUTH_CLIENT_ID is unset):
# TUNNEL_AUTH_TOKEN=
#
# # Auth posture 2 — OAuth2 client_credentials (mutually exclusive with the
# # bearer above — set these three and leave TUNNEL_AUTH_TOKEN empty). When
# # Twilio takes over as the canonical issuer, flip OAUTH_TOKEN_URL to
# # https://oauth.twilio.com/v2/token; no other change required.
# OAUTH_CLIENT_ID=cid_tsec...
# OAUTH_CLIENT_SECRET=cs_...
# OAUTH_TOKEN_URL=https://your-controller.example.com/oauth2/token

# ─── Global connector config (both modes) ──────────────────────────────────

# Optional. Inspector UI port (default 9090). Set to 0 to disable.
# INSPECTOR_PORT=9090

# Optional. Base port for Type 1 auto-allocation (default 7100). The spawner
# probes upward from here; you should never need to change this unless 7100+
# is already taken on this host.
# MCP_BASE_PORT=7100
