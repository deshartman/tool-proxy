# Copy to .env and fill in. .env is gitignored.
# Holds only values genuinely shared across all MCP server deployments.
# Per-deployment values live in each MCP server directory's own .env
# (e.g. examples/sample-mcp-server/.env, examples/twilio-mcp-server/.env).

# Public WSS URL exposed by your controller. The connector dials OUT to this;
# http(s) auto-rewritten to ws(s).
# CONTROLLER_URL=wss://your-controller.example.com/tunnel

# Stamped into the ToolManifest.version field; defaults to "dev".
# CONNECTOR_VERSION=0.1.0
