# Main server — Fly.io deployment
#
# Values here are NEVER committed and NEVER baked into the Docker image.
# Set them on Fly via:
#
#   flyctl secrets set TUNNEL_AUTH_TOKEN=$(openssl rand -hex 32)
#
# This file exists only to document which env vars the deployed image expects.

# Required in production. Shims must send `Authorization: Bearer <same value>`
# on the tunnel POST. Without this set, the main server logs a warning and
# accepts unauthenticated connections — fine for dev, NOT for a public URL.
TUNNEL_AUTH_TOKEN=

# PORT is set automatically by Fly's runtime; no need to override.
