# shim-b — local development (everything on the laptop)
#
# Used by: ./scripts/run-demo.sh         (default MODE=dev)
#
# Copy to `shim-b.env.dev` and fill in your real OPENAI_API_KEY.
OPENAI_API_KEY=sk-customer-b-key-here
OPENAI_MODEL=gpt-4o-mini

# Local main server.
MAIN_SERVER_URL=http://localhost:8080/tunnel
SHIM_CONFIG=config/shim-b.yaml

# No tunnel auth in dev mode — main server runs without TUNNEL_AUTH_TOKEN set.
