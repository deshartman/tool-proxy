# shim-b — laptop dialing Fly AND fanning out to local demo-ui.
#
# Used by: ./scripts/run-demo.sh local-ui

OPENAI_API_KEY=sk-customer-b-key-here
OPENAI_MODEL=gpt-4o-mini

MAIN_SERVER_URL=https://YOUR-APP.fly.dev/tunnel
SHIM_CONFIG=config/shim-b.yaml
TUNNEL_AUTH_TOKEN=

# Local demo-ui process. Must match packages/demo-ui/.env.local-ui.
DEMO_UI_URL=http://localhost:9000
DEMO_UI_TOKEN=
