# shim-b — laptop dialing Fly AND fanning out to local-server.
#
# Used by: ./scripts/run-demo.sh local-ui

OPENAI_API_KEY=sk-customer-b-key-here
OPENAI_MODEL=gpt-4o-mini

MAIN_SERVER_URL=https://YOUR-APP.fly.dev/tunnel
SHIM_CONFIG=config/shim-b.yaml
TUNNEL_AUTH_TOKEN=

# Laptop-side local-server process. Must match packages/local-server/.env.local-ui.
LOCAL_SERVER_URL=http://localhost:9000
LOCAL_SERVER_TOKEN=
