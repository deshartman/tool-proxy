# shim-b — laptop dialing the deployed Fly.io main server
#
# Used by: ./scripts/run-demo.sh local
#
# Copy to `shim-b.env.local` and fill in your real values.
OPENAI_API_KEY=sk-customer-b-key-here
OPENAI_MODEL=gpt-4o-mini

# Public Fly URL of the main server.
MAIN_SERVER_URL=https://YOUR-APP.fly.dev/tunnel
SHIM_CONFIG=config/shim-b.yaml

# Must match the TUNNEL_AUTH_TOKEN secret set on Fly:
#   flyctl secrets set TUNNEL_AUTH_TOKEN=...
TUNNEL_AUTH_TOKEN=
