# shim-a — laptop dialing Fly AND fanning out to local-server.
#
# Used by: ./scripts/run-demo.sh local-ui
#
# Copy to `shim-a.env.local-ui` and fill in your real values. The first five
# vars match the `.env.local` file. The last two add the local-server sink.

OPENAI_API_KEY=sk-customer-a-key-here
OPENAI_MODEL=gpt-4o-mini

MAIN_SERVER_URL=https://YOUR-APP.fly.dev/tunnel
SHIM_CONFIG=config/shim-a.yaml
TUNNEL_AUTH_TOKEN=

# Laptop-side local-server process. Must match packages/local-server/.env.local-ui.
LOCAL_SERVER_URL=http://localhost:9000
LOCAL_SERVER_TOKEN=
