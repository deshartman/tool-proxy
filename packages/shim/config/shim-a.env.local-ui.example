# shim-a — laptop dialing Fly AND fanning out to local demo-ui.
#
# Used by: ./scripts/run-demo.sh local-ui
#
# Copy to `shim-a.env.local-ui` and fill in your real values. The first six
# vars match the `.env.local` file. The last two add the demo-ui sink.

OPENAI_API_KEY=sk-customer-a-key-here
OPENAI_MODEL=gpt-4o-mini

MAIN_SERVER_URL=https://YOUR-APP.fly.dev/tunnel
SHIM_CONFIG=config/shim-a.yaml
TUNNEL_AUTH_TOKEN=

# Local demo-ui process. Must match packages/demo-ui/.env.local-ui.
DEMO_UI_URL=http://localhost:9000
DEMO_UI_TOKEN=
