# demo-ui — laptop-side process serving the "shim view" tab.
#
# Used by: ./scripts/run-demo.sh local-ui
#
# Copy to `.env.local-ui` and edit. DEMO-ONLY: this process opens an inbound
# port on the laptop so a browser tab can render shim activity. Production
# shims do not run this process and do not set DEMO_UI_URL.

DEMO_UI_PORT=9000

# Shared secret. Each shim must send `Authorization: Bearer <same value>` on
# its POST /events. Generate locally: `openssl rand -hex 32`.
DEMO_UI_TOKEN=replace-with-openssl-rand-hex-32
