# Connector-level shared env. Copy to .env (gitignored).
# Per-MCP secrets (Twilio API key, etc.) live in examples/<name>/.env, NOT here.

# Controller HTTPS root. The connector dials this for the register API call
# and for the WS tunnel — internally it upgrades https:// → wss:// and
# appends the /mcp-tunnel path. One host, one URL.
CONTROLLER_URL=https://your-controller.example.com

# Tunnel handshake auth — pick ONE posture. The controller-side row decides
# which one applies; the connector dispatches purely on whether
# OAUTH_CLIENT_ID is set.
#
# ── Posture 1: long-lived bearer (default) ───────────────────────────────
# When the Tunnel Security row was created with type "Twilio Auth Token" or
# "Twilio API Key", the controller mints a single `ts_<...>` secret and
# shows it once. Paste it here. Rotate via the row's detail page; the
# previous secret stays valid 24h after rotation. The connector sends it
# as `Authorization: Bearer <value>` plus `X-Connector-Name:
# <CONNECTOR_NAME>` on the WS upgrade.
TUNNEL_AUTH_TOKEN=

# ── Posture 2: OAuth2 client_credentials ─────────────────────────────────
# When the Tunnel Security row was created with type "OAuth 2.0
# (client_credentials)", the controller hands you a `client_id` +
# `client_secret` instead. The connector POSTs them to OAUTH_TOKEN_URL
# every ~1h to mint a fresh JWT, then presents the JWT as the WS-upgrade
# bearer. Mutually exclusive with TUNNEL_AUTH_TOKEN above — set these
# three and leave TUNNEL_AUTH_TOKEN empty.
#
# When Twilio takes over as the canonical issuer, flip OAUTH_TOKEN_URL to
# https://oauth.twilio.com/v2/token; no other change required.
# OAUTH_CLIENT_ID=cid_tsec...
# OAUTH_CLIENT_SECRET=cs_...
# OAUTH_TOKEN_URL=https://your-controller.example.com/oauth2/token

# Connector identity. Customer-chosen, MUST exactly match the Name field on
# the controller's Tunnel Security row above (case-sensitive — the controller
# looks up the row by it). Also drives the registrationToken flow: on first
# connect the controller mints a connectors row keyed to this name and
# returns a token which the connector persists in .connector-state.json
# (gitignored). Required — no default. Referenced as ${CONNECTOR_NAME} in
# connector.yaml.
CONNECTOR_NAME=my-customer

# Optional. Inspector UI port (default 9090). Set to 0 to disable.
# INSPECTOR_PORT=9090

# Optional. Base port for Type 1 auto-allocation (default 7100). The spawner
# probes upward from here; you should never need to change this unless 7100+
# is already taken on this host.
# MCP_BASE_PORT=7100
