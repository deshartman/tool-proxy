# Connector-level shared env. Copy to .env (gitignored).
# Per-MCP secrets (Twilio API key, etc.) live in examples/<name>/.env, NOT here.

# Controller HTTPS root. The connector dials this for the register API call
# and for the WS tunnel — internally it upgrades https:// → wss:// and
# appends the /mcp-tunnel path. One host, one URL.
CONTROLLER_URL=https://your-controller.example.com

# Shared secret with the controller's TUNNEL_AUTH_TOKEN. Used for the WS
# handshake (data plane). Generate:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
TUNNEL_AUTH_TOKEN=

# Connector identity. Customer-chosen, must be unique on the controller. On
# first connect the controller mints a fresh row keyed to this name and
# returns a registrationToken which the connector persists in
# .connector-state.json (gitignored, sibling to this file). Subsequent
# restarts reconnect by token; the name comes along for logs and UI.
# Required — no default. Referenced as ${CONNECTOR_NAME} in connector.yaml.
CONNECTOR_NAME=my-customer

# Optional. Inspector UI port (default 9090). Set to 0 to disable.
# INSPECTOR_PORT=9090

# Optional. Base port for Type 1 auto-allocation (default 7100). The spawner
# probes upward from here; you should never need to change this unless 7100+
# is already taken on this host.
# MCP_BASE_PORT=7100
