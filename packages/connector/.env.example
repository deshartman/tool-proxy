# Connector-level shared env. Copy to .env (gitignored).
# Per-MCP secrets (Twilio API key, etc.) live in examples/<name>/.env, NOT here.

# Controller HTTPS root. Used for the register API call. In production this
# is also where the connector dials the WS tunnel — the connector internally
# upgrades https:// → wss:// so you don't think about wire schemes.
CONTROLLER_URL=https://your-controller.example.com

# Optional. Override the WS tunnel host when it lives on a different domain
# than the API (e.g. dev rigs that put ngrok in front of 3001 and 3002
# separately). If blank, the tunnel dials CONTROLLER_URL.
# CONTROLLER_WS_URL=wss://your-controller-tunnel.example.com

# Shared secret with the controller's TUNNEL_AUTH_TOKEN. Used for the WS
# handshake (data plane). Generate:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
TUNNEL_AUTH_TOKEN=

# Note: there is no CONNECTOR_ID env var. Identity is established on the WS
# register frame using `tunnel.name` from connector.yaml; the controller
# returns a registrationToken which the connector persists in
# .connector-state.json (gitignored, sibling to this file).

# Optional. Inspector UI port (default 9090). Set to 0 to disable.
# INSPECTOR_PORT=9090

# Optional. Base port for Type 1 auto-allocation (default 7100). The spawner
# probes upward from here; you should never need to change this unless 7100+
# is already taken on this host.
# MCP_BASE_PORT=7100
