# Connector-level shared env. Copy to .env (gitignored).
# Per-MCP secrets (Twilio API key, etc.) live in examples/<name>/.env, NOT here.

# Controller HTTPS root. The connector dials this for the register API call
# and for the WS tunnel — internally it upgrades https:// → wss:// and
# appends the /mcp-tunnel path. One host, one URL.
CONTROLLER_URL=https://your-controller.example.com

# Per-tunnel bearer minted by the controller. Open the controller UI →
# Tools → Connectors → Tunnel Security → New Tunnel Security. Enter:
#   - Name: must match CONNECTOR_NAME below (case-sensitive)
#   - Twilio credentials: AccountSid + AuthToken, OR AccountSid + ApiKey
# The controller verifies the credentials against Twilio's API, mints a
# `ts_<...>` secret, and shows it once with a copy button. Paste it here.
# Rotate via the same UI; the previous secret stays valid 24h after rotation.
# The connector sends this as `Authorization: Bearer <value>` plus
# `X-Connector-Name: <CONNECTOR_NAME>` on the WS upgrade.
TUNNEL_AUTH_TOKEN=

# Connector identity. Customer-chosen, MUST exactly match the Name field on
# the controller's Tunnel Security row above (case-sensitive — the controller
# looks up the row by it). Also drives the registrationToken flow: on first
# connect the controller mints a connectors row keyed to this name and
# returns a token which the connector persists in .connector-state.json
# (gitignored). Required — no default. Referenced as ${CONNECTOR_NAME} in
# connector.yaml.
CONNECTOR_NAME=my-customer

# Optional. Inspector UI port (default 9090). Set to 0 to disable.
# INSPECTOR_PORT=9090

# Optional. Base port for Type 1 auto-allocation (default 7100). The spawner
# probes upward from here; you should never need to change this unless 7100+
# is already taken on this host.
# MCP_BASE_PORT=7100
