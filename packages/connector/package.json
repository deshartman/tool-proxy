{
  "name": "@mcp-shim/connector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-connector": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
