# Connector configuration. Customer-authored, reviewable in their repo.
# Schema mirrors MCP-TUNNEL.md "Configuration surface".
#
# Copy this file to connector-a.yaml (gitignored), fill in your values, then:
#   ./scripts/run-connector.sh
# The connector serves an inspector UI at http://localhost:9090/.
#
# ENV VAR INTERPOLATION
#   Any ${VAR} or ${VAR:-fallback} in this file is substituted from the process
#   environment before parse. Use it to keep secrets out of disk-readable YAML.
#   Recognized env vars at boot:
#     CONNECTOR_CONFIG     path to this file (required)
#     CONNECTOR_VERSION    stamped into ToolManifest.version (optional)
#     INSPECTOR_PORT       inspector UI port; 0 disables (optional, default 9090)
#   Plus any vars you reference inside this file via ${...}.

tunnel:
  # Public WSS URL exposed by your controller. The connector dials OUT to this;
  # http(s) is auto-rewritten to ws(s). Examples:
  #   wss://your-controller.example.com/tunnel
  #   https://abcd1234.ngrok.dev/tunnel        (ngrok agent on the controller side)
  controller_url: https://your-tunnel.example.com/tunnel

  # Pre-provisioned in your controller's UI per MCP-TUNNEL.md decision D5.
  # The controller looks this up to associate the inbound register frame with
  # an existing record. Format depends on your controller; e.g. conn_xxxxxxxx.
  connector_id: REPLACE_ME

  environment: dev

  # Optional bearer token sent on the WSS handshake. Sourced from the env so
  # the YAML stays safe to commit. Omit the line entirely to send no token.
  auth_token: ${TUNNEL_AUTH_TOKEN:-}

  # Optional / advisory:
  # account_sid: AC...
  # region: us1
  # credentials_file: /etc/twilio/tunnel.pem   # mTLS not yet implemented

mcp_servers:
  # Each entry is a local MCP server the connector connects to and aggregates
  # tools from. transport: http | stdio. Add as many as you need. The trust
  # boundary is per-server: every tool a server here exposes is forwarded to
  # the controller. Pick which servers to run carefully.
  - name: sample
    transport: http
    endpoint: http://localhost:7100/mcp        # the bundled sample-mcp-server
    timeout_ms: 5000

policy:
  fail_mode: fail_fast                # only fail_fast supported
  log_tool_args: redacted             # none | redacted | full
  max_concurrent_calls: 64
  discovery_interval_ms: 30000        # poll local MCP servers for tool changes
  heartbeat_interval_ms: 1500
  tool_timeout_ms: 5000
