# local-server — laptop-side control plane.
#
# Used by: ./scripts/run-demo.sh local-ui
#
# Copy to `.env.local-ui` and edit. This process opens an inbound port on the
# laptop so a browser tab can render shim activity AND submit Change-document
# requests. Production shims do not run this process and do not set
# LOCAL_SERVER_URL on their own side.

LOCAL_SERVER_PORT=9000

# Shared secret. Each shim must send `Authorization: Bearer <same value>` on
# its POST /events. Generate locally: `openssl rand -hex 32`.
LOCAL_SERVER_TOKEN=replace-with-openssl-rand-hex-32
