# Template for docker-compose.prod.yml
# Copy to .env and edit before running `docker compose -f docker-compose.prod.yml up -d`.

# ---- Connector image ----
# Pin a version instead of :latest in real deployments.
MCP_VERSION=latest

# ---- Postgres password ----
# Must match the content of ./secrets/pg_password (interpolated into POSTGRES_URL).
# Generate with: openssl rand -hex 24 > ./secrets/pg_password
POSTGRES_PASSWORD=CHANGE_ME_TO_MATCH_secrets/pg_password

# ---- Optional overrides ----
# LOG_LEVEL=info                # pino level. Debug is chatty.
# INSPECTOR_PORT=9090           # loopback-only; do NOT expose beyond 127.0.0.1
